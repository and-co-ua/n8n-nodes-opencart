      ],
      "parameters": {
        "options": {
          "systemMessage": "You are the assistant of an OpenCart store. Use the tools to look up products, stock, orders and customers. Answer briefly, with prices and order numbers."
        }
      }
    },
    {
      "id": "27369735-99ea-43cb-ae58-9b37cf5a88ea",
      "name": "Claude",
