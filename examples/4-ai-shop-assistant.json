    {
      "id": "302870b3-a348-4efb-ad24-f1e8e4dee2db",
      "name": "Find products",
      "type": "@and-co-ua/n8n-nodes-opencart.openCartTool",
      "typeVersion": 1,
      "position": [
        400,
        240
      ],
      "parameters": {
        "toolDescription": "Find products by name, model or SKU; returns price, special price and stock",
        "resource": "product",
        "operation": "getAll",
        "limit": 10,
        "filters": {
          "search": "={{ $fromAI('search', 'Product name, model or SKU', 'string') }}"
        }
      },
      "credentials": {
        "openCartApi": {
          "name": "OpenCart store"
        }
      }
    },
    {
      "id": "4eba7666-a0d7-4130-b88a-143287b1881c",
      "name": "Find orders of a customer",
      "type": "@and-co-ua/n8n-nodes-opencart.openCartTool",
      "typeVersion": 1,
      "position": [
        540,
        240
      ],
      "parameters": {
        "toolDescription": "Find the orders of a customer by e-mail",
        "resource": "order",
        "operation": "getAll",
        "limit": 10,
        "filters": {
          "email": "={{ $fromAI('email', 'E-mail of the customer', 'string') }}"
        }
      },
      "credentials": {
        "openCartApi": {
          "name": "OpenCart store"
        }
      }
    },
    {
      "id": "d5124264-523f-4af9-a205-1cf3413b4075",
      "name": "Order details",
      "type": "@and-co-ua/n8n-nodes-opencart.openCartTool",
      "typeVersion": 1,
      "position": [
        680,
        240
      ],
      "parameters": {
        "toolDescription": "Get an order with its products, totals, addresses and status history",
        "resource": "order",
        "operation": "get",
        "orderId": "={{ $fromAI('order_id', 'Order number', 'number') }}"
      },
      "credentials": {
        "openCartApi": {
          "name": "OpenCart store"
        }
      }
    },
    {
      "id": "c819c4e7-638a-4465-91b3-291adbc6e971",
