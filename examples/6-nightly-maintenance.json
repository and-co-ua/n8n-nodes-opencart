      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1100,
        0
      ],
      "parameters": {
        "jsCode": "const [sessions, carts, cache, log] = ['Clear expired sessions', 'Clear abandoned carts', 'Clear the product cache', 'Last lines of the error log'].map((name) => $(name).first().json);\nconst html = `<h2>Nightly maintenance</h2>\n<ul><li>Expired sessions deleted: <b>${sessions.deleted}</b></li>\n<li>Abandoned carts deleted: <b>${carts.customers}</b> (${carts.customer_items} items)</li>\n<li>Cache cleared: <b>${cache.key}</b></li>\n<li>Error log: <b>${log.size}</b> bytes</li></ul>\n<pre style=\"background:#f4f4f4;padding:8px\">${log.content || 'No errors'}</pre>`;\nreturn [{ json: { html } }];"
      }
    },
    {
      "id": "35e4ea9d-5fa6-44d8-8eda-dd0a39cf4bd0",
      "name": "E-mail the developer",
